# ─────────────────────────────────────────────────────────────
# WorkFlow AI — Frontend environment (safe for the browser)
# Copy to .env.local. Only NEXT_PUBLIC_* values belong here.
# NEVER put XAI_API_KEY or SUPABASE_SECRET_KEY in this file.
# ─────────────────────────────────────────────────────────────

# FastAPI backend base URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase project (publishable / anon key only)
# Leave BOTH blank to run the whole app in demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
