# ─────────────────────────────────────────────────────────────
# WorkFlow AI — Backend environment
# Copy to .env and fill in. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# Groq API (https://console.groq.com/keys) — server-side only, never expose to browser
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Supabase — SERVICE ROLE (secret) key, server-side only.
# This is NOT the same as the anon/publishable key used in the frontend —
# find it under Project Settings → API → service_role.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=workflow-documents

# CORS — comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Hard override: forces the whole app into demo (in-memory) mode even if
# Supabase credentials above are present. Leave false to auto-detect —
# each service (Groq / Supabase) goes live independently once configured.
DEMO_MODE=false

# Public-demo protection limits (configurable)
MAX_FILE_SIZE_MB=10
MAX_DOCUMENTS_PER_USER=5
MAX_CHAT_REQUESTS_PER_DAY=20
MAX_REPORTS_PER_DAY=5

# Embeddings
EMBEDDING_DIM=512
